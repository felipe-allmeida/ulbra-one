    "format:check": "prettier --check .",
    "checks": "pnpm format:check && pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "i18next": "^26.3.1",
    "lucide-react": "^0.477.0",
    "react": "^19.0.0",
